# {{ ansible_managed }}
# Adds to the package's AppArmor profile, which confines Unbound's file
# access (it is in enforce mode, so no path rules here): Unbound starts as
# root to bind port 53 and create its control socket, which Debian's
# remote-control.conf (a conffile) puts directly into /run, hands the socket
# to the unbound group (CAP_CHOWN) and switches to the unbound user before it
# handles any DNS traffic. The trust anchor helper before the start switches
# users too (setpriv). Of the eight capabilities AppArmor allows, these four
# remain: no chroot (unused), no fowner, fsetid or sys_resource.
[Service]
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_CHOWN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/unbound /run
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
