# {{ ansible_managed }}
# Sovereign narrows AIDE's scope: package files are checked by dpkg --verify
# and the unowned-file check (sovereign-integrity-check), without the noise
# every upgrade would cause here. AIDE keeps what packages don't cover.
# Data that changes all the time (mail, databases, statistics) is left out.

# /usr: only /usr/local.
!/usr/(?!local(/|$))
# /var: only the crontabs.
!/var/(?!spool(/cron(/|$)|$))
# Home directories: only the SSH keys.
!/root/(?!\.ssh(/|$))
!/home/[^/]+/(?!\.ssh(/|$))
# Regenerated by every library upgrade (ldconfig) and user change.
!/etc/ld\.so\.cache$
!/etc/\.pwd\.lock$
# Certificates change with every renewal; the DANE check watches the key.
!/etc/letsencrypt/(archive|live|csr|keys)(/|$)
