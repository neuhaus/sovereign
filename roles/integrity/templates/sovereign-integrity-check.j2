#!/bin/bash
# {{ ansible_managed }}
# Daily integrity check, in three parts so that upgrades cause no noise:
#   1. package files that differ from their packages (dpkg --verify),
#      conffiles left out: the roles keep some on purpose
#   2. files in /usr that no package owns: planted programs or libraries
#   3. AIDE for the rest (/etc, /usr/local, /boot, SSH keys, crontabs)
# New findings are mailed to root (the postmaster) once; the same findings
# again are not. The counts go to node_exporter.
#
# Not covered: Python bytecode in __pycache__ (generated by package scripts),
# documentation in /usr/share/doc (not run; some packages leave files there),
# and anything a root attacker changes along with the check itself.
set -uo pipefail

metrics={{ integrity_metrics_dir }}/sovereign_integrity.prom
state={{ integrity_state }}
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# 1. Package files. Lines are "<flags> [c] <path>"; "c" marks a conffile.
dpkg --verify 2>/dev/null | awk 'NF < 3 || $2 != "c"' > "$work/modified"

# 2. Unowned files in /usr. Owned: every package's file list, plus both
# names of each diversion.
{
    cat /var/lib/dpkg/info/*.list
    dpkg-divert --list | sed -n 's/^.*diversion of \(.*\) to \(.*\) by .*$/\1\n\2/p; s/^local diversion of \(.*\) to \(.*\)$/\1\n\2/p'
} | sort -u > "$work/owned"
find /usr -xdev \( -type f -o -type l \) \
    -not -path '/usr/local/*' -not -path '*/__pycache__/*' -not -path '/usr/share/mime/*' -not -path '/usr/share/doc/*' \
    | sort > "$work/present"
comm -23 "$work/present" "$work/owned" | while IFS= read -r path; do
    # Links managed by update-alternatives.
    if [ -L "$path" ] && case "$(readlink "$path")" in /etc/alternatives/*) true;; *) false;; esac; then
        continue
    fi
    case "$path" in
{% for pattern in integrity_usr_expected + integrity_usr_expected_extra %}
    {{ pattern }}) continue;;
{% endfor %}
    esac
    printf '%s\n' "$path"
done > "$work/unowned"

# 3. AIDE. Exit codes 1-7: entries added, removed or changed.
aide --check --config /etc/aide/aide.conf > "$work/aide" 2>&1
aide_rc=$?
if [ "$aide_rc" -ge 8 ]; then
    echo "AIDE failed (exit code $aide_rc):" >&2
    tail -5 "$work/aide" >&2
fi
grep -E '^[fdlbcps][^ ]*: ' "$work/aide" > "$work/aide-entries" || true

modified=$(grep -c . "$work/modified")
unowned=$(grep -c . "$work/unowned")
aide_changes=$(grep -c . "$work/aide-entries")

{
    echo "# HELP sovereign_integrity_findings Files changed behind the admin's back, per check."
    echo "# TYPE sovereign_integrity_findings gauge"
    echo "sovereign_integrity_findings{check=\"package_files\"} $modified"
    echo "sovereign_integrity_findings{check=\"unowned_in_usr\"} $unowned"
    echo "sovereign_integrity_findings{check=\"aide\"} $aide_changes"
    echo "# HELP sovereign_integrity_check_last_run_timestamp_seconds When the integrity check last ran."
    echo "# TYPE sovereign_integrity_check_last_run_timestamp_seconds gauge"
    echo "sovereign_integrity_check_last_run_timestamp_seconds $(date +%s)"
} > "$metrics.new"
chmod 0644 "$metrics.new"
mv "$metrics.new" "$metrics"

echo "package files changed: $modified, unowned in /usr: $unowned, AIDE: $aide_changes"
total=$((modified + unowned + aide_changes))
if [ "$total" -eq 0 ]; then
    rm -f "$state"
    [ "$aide_rc" -lt 8 ]
    exit
fi

# The same findings as last time: already reported.
digest=$(cat "$work/modified" "$work/unowned" "$work/aide-entries" | sha256sum | cut -d' ' -f1)
if [ -f "$state" ] && [ "$(cat "$state")" = "$digest" ]; then
    exit 0
fi
{
    echo "To: root"
    echo "Subject: Integrity check on $(hostname --fqdn): $total changed files"
    echo
    echo "Files changed since they were installed or since the last playbook run."
    echo "If you or the playbook didn't change them, treat the server as"
    echo "compromised (docs/ADMINISTRATION.md, \"Integrity check\")."
    for part in "modified:Package files that differ from their packages (dpkg --verify)" \
                "unowned:Files in /usr that no package owns" \
                "aide-entries:Changed according to AIDE (since the last playbook run)"; do
        file=${part%%:*}
        if [ -s "$work/$file" ]; then
            printf '\n%s:\n' "${part#*:}"
            head -100 "$work/$file"
        fi
    done
    echo
    echo "This mail comes once per set of findings; the check runs daily."
} | /usr/sbin/sendmail -t || { echo "could not mail the postmaster" >&2; exit 1; }
mkdir -p "$(dirname "$state")"
echo "$digest" > "$state"
