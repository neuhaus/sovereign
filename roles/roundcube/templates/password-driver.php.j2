<?php
// {{ ansible_managed }}
//
// Password plugin driver for the Sovereign mail database. It opens the
// database with plain PDO: Roundcube's database layer sets journal_mode = WAL
// on every SQLite connection, and in WAL mode Postfix and Dovecot, which only
// read, could no longer open the file.
class rcube_sovereign_password
{
    public function save($curpass, $passwd, $username)
    {
        $rcmail = rcmail::get_instance();
        $hash = password::hash_password($passwd);
        if ($hash === false) {
            return PASSWORD_CRYPT_ERROR;
        }

        try {
            $db = new PDO('sqlite:{{ roundcube_maildb_path }}', null, null, [
                PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
                PDO::ATTR_TIMEOUT => 10,
            ]);
            $update = $db->prepare('UPDATE mailboxes SET password = ? WHERE localpart = ? AND domain = ?');
            $update->execute([$hash, $rcmail->user->get_username('local'), $rcmail->user->get_username('domain')]);
        } catch (PDOException $e) {
            rcube::raise_error(['code' => 600, 'file' => __FILE__, 'line' => __LINE__,
                'message' => 'Password plugin: ' . $e->getMessage()], true, false);
            return PASSWORD_CONNECT_ERROR;
        }

        return $update->rowCount() === 1 ? PASSWORD_SUCCESS : PASSWORD_ERROR;
    }
}
