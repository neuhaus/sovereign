<?php
// {{ ansible_managed }}
//
// Password plugin driver: asks the password service (sovereign-passwd, maildb
// role) over a local socket. The service checks the current password itself
// and changes only that mailbox, so Roundcube has no access to the mail
// database.
class rcube_sovereign_password
{
    public function save($curpass, $passwd, $username)
    {
        $rcmail = rcmail::get_instance();
        $socket = @stream_socket_client('unix://{{ roundcube_passwd_socket }}', $errno, $errstr, 10);
        if ($socket === false) {
            rcube::raise_error(['code' => 600, 'file' => __FILE__, 'line' => __LINE__,
                'message' => "Password plugin: cannot reach the password service: $errstr"], true, false);
            return PASSWORD_CONNECT_ERROR;
        }
        stream_set_timeout($socket, 30);
        $request = json_encode(['user' => $rcmail->user->get_username(), 'current' => $curpass, 'new' => $passwd]);
        fwrite($socket, $request . "\n");
        $line = fgets($socket, 8192);
        fclose($socket);

        $reply = json_decode($line === false ? '' : $line, true);
        if (!is_array($reply)) {
            rcube::raise_error(['code' => 600, 'file' => __FILE__, 'line' => __LINE__,
                'message' => 'Password plugin: no answer from the password service'], true, false);
            return PASSWORD_CONNECT_ERROR;
        }
        if (!empty($reply['ok'])) {
            return PASSWORD_SUCCESS;
        }
        return ['code' => PASSWORD_ERROR, 'message' => (string) ($reply['error'] ?? 'error')];
    }
}
