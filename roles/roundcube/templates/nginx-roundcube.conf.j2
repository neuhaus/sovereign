# {{ ansible_managed }}
# Webmail (Roundcube). Nothing is reachable without basic auth. Behind it only
# the front controller runs and only static assets of the listed types are
# served; everything else in the tree stays out of reach.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ roundcube_host }};
    include /etc/nginx/snippets/sovereign-tls.conf;
    root /var/lib/roundcube/public_html;
    client_max_body_size {{ roundcube_post_max_size }};
    auth_basic "Webmail";
    auth_basic_user_file /etc/nginx/roundcube.htpasswd;
    # Failed attempts go to the journal for the nginx-http-auth jail.
    error_log syslog:server=unix:/dev/log,tag=nginx error;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    location = / {
        rewrite ^ /index.php last;
    }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTPS on;
        # The basic auth password is none of Roundcube's business.
        fastcgi_param HTTP_AUTHORIZATION "";
        fastcgi_pass unix:/run/php/roundcube.sock;
    }
    location ~ ^/(?:plugins|skins|program)/.+\.(?:js|css|png|gif|jpe?g|svg|ico|woff2?|ttf|eot|map|html)$ {
        expires 7d;
    }
    # Not "return 404": that runs before the access phase and so without basic auth.
    location / {
        try_files /nonexistent =404;
    }
}
