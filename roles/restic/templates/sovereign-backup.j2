#!/bin/bash
# {{ ansible_managed }}
#
# sovereign-backup init   create the repository if there is none
# sovereign-backup run    back up databases, mail and keys
# sovereign-backup prune  apply the retention policy
# sovereign-backup check  check the repository's structure
#
# Other restic commands: set -a; . /etc/restic/env; set +a; restic snapshots
set -euo pipefail
set -a
. /etc/restic/env
set +a

# Writes "name value" lines to one textfile for node_exporter, atomically.
write_metrics() {
    local file={{ restic_metrics_dir }}/$1.prom
    shift
    printf '%s\n' "$@" > "$file.new"
    chmod 0644 "$file.new"
    mv "$file.new" "$file"
}

# A database copy that fails SQLite's check: tell the postmaster. Sent on
# every run until it is fixed; the backup fails meanwhile.
report_damaged() {
    local name=$1 path=$2 result=$3
    echo "database $name ($path) is damaged; the last good copy stays: $result" >&2
    /usr/sbin/sendmail -t <<MAIL || echo "could not mail the postmaster" >&2
To: root
Subject: Backup: database $name on $(hostname --fqdn) is damaged

SQLite's check of a fresh copy of $path failed:

$result

The backup keeps the last good copy of this database and backs up
everything else; the run counts as failed until the database is repaired or
restored (docs/BACKUP.md). Mail and other databases are backed up as usual.
MAIL
}

backup() {
    restic backup --one-file-system --retry-lock 30m --tag sovereign \
{% for exclude in restic_excludes %}
        --exclude {{ exclude | quote }} \
{% endfor %}
        {{ restic_paths | map('quote') | join(' ') }}
}

case "${1:-}" in
init)
    # Exit code 10: no repository. Anything else (network down, wrong password)
    # must not create one.
    rc=0
    restic cat config >/dev/null 2>&1 || rc=$?
    case $rc in
    0) ;;
    10)
        restic init
        echo initialised
        ;;
    *)
        echo "cannot read the repository (restic exit code $rc)" >&2
        exit "$rc"
        ;;
    esac
    ;;
run)
    # The attempt is recorded however the script ends: a failing database copy
    # stops it (set -e) before restic runs, and must not leave the exit code of
    # an earlier run in place. Until restic has run, the code is 1.
    rc=1
    record_attempt() {
        write_metrics sovereign_backup_attempt \
            "sovereign_backup_last_attempt_timestamp_seconds ${now:-$(date +%s)}" \
            "sovereign_backup_last_exit_code $rc"
    }
    trap record_attempt EXIT
    # Each copy is checked before it replaces the previous one: a damaged
    # database must not push the last good copy out of the backups.
    damaged=""
{% for database in restic_databases %}
    sqlite3 -bail -cmd ".timeout 30000" {{ database.path | quote }} ".backup {{ restic_staging_dir }}/{{ database.name }}.new"
    check=$(sqlite3 -bail {{ restic_staging_dir }}/{{ database.name }}.new "PRAGMA quick_check" 2>&1) || true
    if [ "$check" = ok ]; then
        mv {{ restic_staging_dir }}/{{ database.name }}.new {{ restic_staging_dir }}/{{ database.name }}
    else
        rm -f {{ restic_staging_dir }}/{{ database.name }}.new
        report_damaged {{ database.name | quote }} {{ database.path | quote }} "$check"
        damaged="$damaged {{ database.name }}"
    fi
{% endfor %}
    # Exit code 3: a snapshot was made, but some files could not be read, so it
    # is incomplete. On a live Maildir the usual cause is a message Dovecot
    # renamed in the meantime (a flag change), so one more run, which only
    # reads what changed, usually completes. If that fails too, the backup
    # fails: permission or read errors must not pass as success.
    rc=0
    backup || rc=$?
    if [ "$rc" -eq 3 ]; then
        echo "some files could not be read; running the backup once more" >&2
        rc=0
        backup || rc=$?
    fi
    now=$(date +%s)
    [ "$rc" -eq 0 ] || exit "$rc"
    if [ -n "$damaged" ]; then
        echo "backed up, but with the last good copy of:$damaged" >&2
        rc=1
        exit 1
    fi
    write_metrics sovereign_backup \
        "sovereign_backup_last_success_timestamp_seconds $now"
    ;;
check)
    # Structure and metadata only; reading all data back would download the
    # whole repository. "restic check --read-data-subset 5%" does part of it.
    rc=0
    restic check --retry-lock 30m || rc=$?
    now=$(date +%s)
    write_metrics sovereign_backup_check_attempt \
        "sovereign_backup_check_last_attempt_timestamp_seconds $now" \
        "sovereign_backup_check_last_exit_code $rc"
    [ "$rc" -eq 0 ] || exit "$rc"
    write_metrics sovereign_backup_check \
        "sovereign_backup_check_last_success_timestamp_seconds $now"
    ;;
prune)
    restic forget --prune --retry-lock 30m --tag sovereign \
        --keep-daily {{ restic_keep_daily }} \
        --keep-weekly {{ restic_keep_weekly }} \
        --keep-monthly {{ restic_keep_monthly }}
    ;;
*)
    echo "usage: $0 init|run|prune|check" >&2
    exit 2
    ;;
esac
