# {{ ansible_managed }}
# Mail client autoconfiguration (Thunderbird autoconfig, Outlook autodiscover,
# Apple configuration profiles).

# Signed Apple profile per autoconfig host. An explicit map, so that $host
# never becomes part of a file path.
map $host $sovereign_mobileconfig {
    default "";
{% for domain in autoconfig_domains %}
    autoconfig.{{ domain }} {{ domain }}.mobileconfig;
{% endfor %}
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ (autoconfig_domains | map('regex_replace', '^', 'autoconfig.') | list
                    + autoconfig_domains | map('regex_replace', '^', 'autodiscover.') | list) | join(' ') }};
    include /etc/nginx/snippets/sovereign-tls.conf;
    include /etc/nginx/snippets/sovereign-wellknown.conf;
    include /etc/nginx/snippets/sovereign-static-headers.conf;
    root {{ autoconfig_webroot }};

    location = /mail/config-v1.1.xml {
        default_type application/xml;
    }
    location = /.well-known/autoconfig/mail/config-v1.1.xml {
        default_type application/xml;
        try_files /mail/config-v1.1.xml =404;
    }
    # Outlook POSTs its request; answer every method with the static file
    # (nginx refuses POST to static files with 405 otherwise).
    location ~* ^/autodiscover/autodiscover\.xml$ {
        default_type application/xml;
        error_page 405 =200 /autodiscover/autodiscover.xml;
        try_files /autodiscover/autodiscover.xml =404;
    }
    location = /mail.mobileconfig {
        if ($sovereign_mobileconfig = "") {
            return 404;
        }
        # Safari recognizes the profile by this type. No add_header here: it
        # would drop the server-level headers, HSTS among them.
        default_type application/x-apple-aspen-config;
        try_files /mobileconfig/$sovereign_mobileconfig =404;
    }
    location / {
        return 404;
    }
}
