# {{ ansible_managed }}
#
# Complete Dovecot 2.4 configuration for Sovereign. Debian's conf.d/ is not
# included on purpose: everything Dovecot does is defined in this file.
dovecot_config_version = 2.4.1
dovecot_storage_version = 2.4.1

protocols {
  imap = yes
  lmtp = yes
  sieve = yes
}
listen = {{ dovecot_listen }}

# --- TLS -------------------------------------------------------------------
# No plaintext logins: IMAP on 143 requires STARTTLS first (auth_allow_cleartext
# = no), 993 is implicit TLS.
ssl = required
ssl_server_cert_file = {{ dovecot_tls_cert_file }}
ssl_server_key_file = {{ dovecot_tls_key_file }}
ssl_min_protocol = {{ dovecot_tls_min_protocol }}
ssl_cipher_list = {{ dovecot_tls12_ciphers }}
ssl_cipher_suites = {{ dovecot_tls13_ciphersuites }}
ssl_curve_list = {{ dovecot_tls_curves }}

# --- Authentication ----------------------------------------------------------
auth_allow_cleartext = no
auth_mechanisms = plain login
auth_username_format = %{user | lower}

sql_driver = sqlite
sqlite_path = {{ dovecot_maildb_path }}
# Dovecot only reads the mail database. Its defaults (read-write, WAL) would
# switch the database to WAL, after which Postfix cannot read it any more.
sqlite_readonly = yes
sqlite_journal_mode = delete

# Main password first; on mismatch Dovecot continues with the app passwords.
# Each passdb query returns at most one row: Dovecot 2.4 fails a lookup with
# several rows, so app passwords are selected by their 8-character id prefix.
# Not valid from loopback, i.e. for Roundcube: its session password counts as
# the current password when changing the main password, and an app password
# must not be enough for that. Radicale's auth requests carry no address.
passdb main {
  driver = sql
  sql_query = SELECT localpart || '@' || domain AS user, password \
    FROM mailboxes \
    WHERE localpart = '%{user | username}' AND domain = '%{user | domain}' AND enabled = 1
}

passdb apps {
  driver = sql
  sql_query = SELECT a.localpart || '@' || a.domain AS user, a.password \
    FROM app_passwords a JOIN mailboxes m ON m.localpart = a.localpart AND m.domain = a.domain \
    WHERE a.localpart = '%{user | username}' AND a.domain = '%{user | domain}' \
      AND a.id = substr('%{password}', 1, 8) AND m.enabled = 1 \
      AND '%{remote_ip}' NOT IN ('127.0.0.1', '::1')
}

userdb sql {
  sql_query = SELECT localpart || '@' || domain AS user \
    FROM mailboxes \
    WHERE localpart = '%{user | username}' AND domain = '%{user | domain}' AND enabled = 1
  sql_iterate_query = SELECT localpart || '@' || domain AS user FROM mailboxes WHERE enabled = 1
}

# --- Mail storage ------------------------------------------------------------
mail_uid = {{ dovecot_vmail_user }}
mail_gid = {{ dovecot_vmail_user }}
# vmail is a system user (its UID is below Dovecot's default first_valid_uid
# of 500 on some systems); allow exactly this UID for mail access.
first_valid_uid = {{ dovecot_vmail_account.uid }}
last_valid_uid = {{ dovecot_vmail_account.uid }}
mail_driver = maildir
mail_home = {{ dovecot_vmail_dir }}/%{user | domain}/%{user | username}
mail_path = ~/Maildir

# Plus addressing: user+tag@domain is delivered to user's INBOX.
recipient_delimiter = +
lmtp_save_to_detail_mailbox = no

namespace inbox {
  inbox = yes
  mailbox Drafts {
    special_use = \Drafts
    auto = subscribe
  }
  mailbox Sent {
    special_use = \Sent
    auto = subscribe
  }
  mailbox Archive {
    special_use = \Archive
    auto = subscribe
  }
  mailbox Junk {
    special_use = \Junk
    auto = subscribe
    fts_autoindex = no
{% if dovecot_spam_learning %}
    # Moving mail into Junk trains it as spam (Rspamd).
    sieve_script report_spam {
      type = before
      cause = copy
      path = {{ dovecot_sieve_global_dir }}/report-spam.sieve
    }
{% endif %}
  }
  mailbox Trash {
    special_use = \Trash
    auto = subscribe
    fts_autoindex = no
  }
}

mail_plugins {
  mail_crypt = yes
{% if dovecot_fts_enabled %}
  fts = yes
  fts_flatcurve = yes
{% endif %}
}

# --- At-rest encryption (mail_crypt, global key pair) ------------------------
crypt_global_public_key_file = {{ dovecot_mail_crypt_dir }}/ecpubkey.pem
crypt_global_private_key main {
  crypt_private_key_file = {{ dovecot_mail_crypt_dir }}/ecprivkey.pem
}
{% if dovecot_fts_enabled %}

# --- Full-text search (fts-flatcurve) ----------------------------------------
# The index is stored unencrypted next to the mail indexes; its protection is
# the disk encryption (LUKS).
fts_autoindex = yes
fts_autoindex_max_recent_msgs = 999
fts flatcurve {
}
language_tokenizers = generic email-address
language_tokenizer_generic_algorithm = simple
language_filters = lowercase
language en {
  default = yes
}

service indexer-worker {
  process_limit = {{ dovecot_fts_indexer_processes }}
  vsz_limit = {{ dovecot_fts_indexer_memory }}
}
{% endif %}

# --- Sieve (delivery filters, managed via ManageSieve on 4190) ---------------
sieve_script personal {
  driver = file
  path = ~/sieve
  active_path = ~/.dovecot.sieve
}

protocol lmtp {
  mail_plugins {
    sieve = yes
  }
}
{% if dovecot_spam_learning %}

# Spam learning: moving mail out of Junk trains it as ham (see also the Junk
# mailbox above). The scripts pipe the message to Rspamd.
protocol imap {
  mail_plugins {
    imap_sieve = yes
  }
}
sieve_plugins {
  sieve_imapsieve = yes
  sieve_extprograms = yes
}
sieve_global_extensions {
  vnd.dovecot.pipe = yes
}
sieve_pipe_bin_dir = {{ dovecot_sieve_pipe_dir }}
imapsieve_from Junk {
  sieve_script report_ham {
    type = before
    cause = copy
    path = {{ dovecot_sieve_global_dir }}/report-ham.sieve
  }
}
{% endif %}

# --- Services ------------------------------------------------------------------
service imap-login {
  inet_listener imap {
    port = 143
  }
  inet_listener imaps {
    port = 993
    ssl = yes
  }
}

service managesieve-login {
  inet_listener sieve {
    port = 4190
  }
}

# Delivery from Postfix (inside its chroot).
service lmtp {
  unix_listener {{ dovecot_postfix_spool }}/private/dovecot-lmtp {
    user = postfix
    group = postfix
    mode = 0600
  }
}

# SMTP AUTH for Postfix submission.
service auth {
  unix_listener {{ dovecot_postfix_spool }}/private/auth {
    user = postfix
    group = postfix
    mode = 0660
  }
  # Logins of other local services (Radicale), for members of this group.
  unix_listener {{ dovecot_auth_socket }} {
    user = dovecot
    group = {{ dovecot_auth_group }}
    mode = 0660
  }
}

# Metrics in OpenMetrics format on http://<host>:{{ dovecot_metrics_port }}/metrics.
service stats {
  inet_listener http {
    port = {{ dovecot_metrics_port }}
  }
}

metric auth_success {
  filter = event=auth_request_finished AND success=yes
}

metric auth_failure {
  filter = event=auth_request_finished AND NOT success=yes
}

metric mail_delivery {
  filter = event=mail_delivery_finished
}
