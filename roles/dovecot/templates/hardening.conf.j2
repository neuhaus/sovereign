# {{ ansible_managed }}
# Sandbox for Dovecot. The login processes already run as dovenull in an
# empty chroot; this confines the rest. The master (root) binds 143, 993 and
# 4190, starts processes as vmail, dovecot and dovenull, chroots the login
# processes, sets socket owners (CAP_CHOWN), signals its children (CAP_KILL)
# and creates its sockets for Postfix in /var/spool/postfix/private, which
# belongs to postfix with mode 0700 (CAP_DAC_OVERRIDE). Dovecot runs only
# rspamc (spam training) and uses no JIT.
[Service]
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_SYS_CHROOT CAP_CHOWN CAP_DAC_OVERRIDE CAP_KILL
ProtectSystem=strict
# Root-owned 0755, as Dovecot expects its base_dir.
RuntimeDirectory=dovecot
RuntimeDirectoryMode=0755
ProtectHome=yes
# Allowlist: an empty /var with only the mail, Dovecot's state, Postfix's
# private socket directory and the mail database (read-only, for logins).
TemporaryFileSystem=/var:ro /srv:ro /opt:ro /mnt:ro /media:ro
BindPaths={{ dovecot_vmail_dir }} /var/lib/dovecot {{ dovecot_postfix_spool }}/private
BindReadOnlyPaths={{ dovecot_maildb_path | dirname }}
ReadWritePaths={{ dovecot_vmail_dir }} /var/lib/dovecot {{ dovecot_postfix_spool }}/private
InaccessiblePaths={{ dovecot_inaccessible_paths | map('regex_replace', '^', '-') | join(' ') }}
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @setuid chroot
