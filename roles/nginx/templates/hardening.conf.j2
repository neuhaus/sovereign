# {{ ansible_managed }}
# Sandbox for nginx, the first thing every web request reaches. The master
# (root) binds 80 and 443, reads the TLS keys, starts the workers as
# www-data, signals them (CAP_KILL), creates its temp directories
# (CAP_CHOWN) and reopens the log files, which belong to www-data, after
# rotation (CAP_DAC_OVERRIDE). nginx runs no programs and uses no regex JIT.
[Service]
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_KILL
ProtectSystem=strict
# /run for the PID file, which Debian's nginx.conf (a conffile) puts there.
ReadWritePaths=/run /var/log/nginx /var/lib/nginx
ProtectHome=yes
# Allowlist: an empty /var with only the webroots (read-only), the logs and
# nginx's temp files. The Roundcube role restarts nginx after installing,
# because a missing path is skipped and only a restart mounts it.
TemporaryFileSystem=/var:ro /srv:ro /opt:ro /mnt:ro /media:ro
BindReadOnlyPaths=/var/www -/var/lib/roundcube
BindPaths=/var/log/nginx /var/lib/nginx
InaccessiblePaths={{ nginx_inaccessible_paths | map('regex_replace', '^', '-') | join(' ') }}
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
