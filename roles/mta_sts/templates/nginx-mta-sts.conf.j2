# {{ ansible_managed }}
# MTA-STS policy (RFC 8461) for all mail domains.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ mta_sts_domains | map('regex_replace', '^', 'mta-sts.') | join(' ') }};
    include /etc/nginx/snippets/sovereign-tls.conf;

    location = /.well-known/mta-sts.txt {
        alias {{ mta_sts_webroot }}/mta-sts.txt;
        default_type text/plain;
    }

    location / {
        return 404;
    }
}
