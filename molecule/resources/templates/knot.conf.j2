# {{ ansible_managed }}
# Authoritative mock DNS for Molecule tests.

server:
    rundir: "/run/knot"
    user: knot:knot
    # Only the test address: systemd-resolved's stub listener already holds
    # port 53 on loopback, so a wildcard bind fails.
    listen: [ {{ sovtest_ips.dns }}@53 ]

log:
  - target: syslog
    any: info

database:
    storage: "/var/lib/knot"

template:
  - id: default
    storage: "/var/lib/knot"
    file: "%s.zone"

zone:
  - domain: {{ sovtest_domain }}
  # A foreign domain whose MX is a test SMTP sink on this instance (SRS test).
  - domain: {{ sovtest_external_domain }}
  # A second mail domain on the mail server.
  - domain: {{ sovtest_second_domain }}
{% for zone in sovtest_signed_zones + sovtest_dane_zones %}
  # Signed automatically (default policy: ECDSA P-256). The mail instance trusts
  # the DS of signed.test; for broken.test it gets a wrong DS on purpose.
  - domain: {{ zone }}
    dnssec-signing: on
{% endfor %}
