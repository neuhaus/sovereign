---
extends: default

# Legacy paths, see .ansible-lint for why they are excluded.
ignore: |
  site.yml
  group_vars/
  roles/common/
  roles/mailserver/
  roles/webmail/

rules:
  # Settings compatible with ansible-lint's own yamllint expectations.
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  line-length:
    max: 160
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false"]
    # GitHub Actions workflows use the key "on".
    check-keys: false
